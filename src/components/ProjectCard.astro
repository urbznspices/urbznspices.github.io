---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'> }
const { project } = Astro.props;
const d = project.data;
---
<a class="pcard" href={`/projects/${project.id}`}>
  <div class="media">
    <img src={d.cover} alt={d.coverAlt} loading="lazy" decoding="async" />
    {d.demo && <span class="live">Interactive demo</span>}
  </div>
  <div class="body">
    <p class="meta label">{d.category ?? d.org}</p>
    <h3>{d.title}</h3>
    <p class="tagline">{d.tagline}</p>
    <dl class="facts">
      <dt class="sr-only">Role</dt><dd class="role">{d.role}</dd>
      <dt class="sr-only">Dates</dt><dd>{d.dates}</dd>
    </dl>
    <ul class="tags">
      {d.tools.slice(0, 3).map((t) => <li class="tag">{t}</li>)}
    </ul>
  </div>
</a>

<style>
  .pcard {
    display: flex; flex-direction: column; height: 100%; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden;
    transition: border-color .15s ease, box-shadow .15s ease;
  }
  .pcard:hover { border-color: var(--line-strong); box-shadow: var(--shadow); color: var(--ink); text-decoration: none; }
  .pcard:hover h3 { color: var(--accent); }
  .media { position: relative; aspect-ratio: 16 / 10; background: var(--surface-2); border-bottom: 1px solid var(--line); overflow: hidden; }
  .media img { width: 100%; height: 100%; object-fit: cover; }
  .live { position: absolute; top: 10px; left: 10px; font-size: 12px; font-weight: 600; background: var(--surface); color: var(--ink); border: 1px solid var(--line); padding: 3px 8px; border-radius: 4px; }
  .body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .meta { margin: 0; font-size: 11.5px; }
  h3 { font-size: 19px; transition: color .15s ease; }
  .tagline { margin: 0; color: var(--ink-2); font-size: 15px; line-height: 1.55; }
  .facts { margin: 4px 0 0; font-size: 13.5px; color: var(--muted); line-height: 1.45; }
  .facts dd { margin: 0; }
  .facts .role { color: var(--ink-2); font-weight: 500; }
  .tags { list-style: none; margin: auto 0 0; padding: 10px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags .tag { font-size: 12px; }
</style>
