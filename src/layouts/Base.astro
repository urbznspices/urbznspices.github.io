---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'Arel Urbanozo: aerospace engineering senior at UAH working in spacecraft systems and communications engineering, CubeSat hardware, and test.',
  image = '/images/og.png',
} = Astro.props;
const fullTitle = title ? `${title} · Arel Urbanozo` : 'Arel Urbanozo · Aerospace Engineering';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/#experience', label: 'Experience' },
  { href: '/#projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Résumé' },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand">Arel Urbanozo</a>
        <nav aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <button class="theme" type="button" aria-label="Toggle color theme" title="Toggle theme">
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.5 0-.9-.1-1.4A5.5 5.5 0 0 1 13.4 3.1 9 9 0 0 0 12 3z" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer" id="contact">
      <div class="wrap foot">
        <div>
          <h2 class="foot-title">Contact</h2>
          <p>Open to spacecraft systems engineering and technical program roles beginning 2027.</p>
        </div>
        <ul class="foot-links">
          <li><span class="label">Email</span><a href="mailto:arelurbz@gmail.com">arelurbz@gmail.com</a></li>
          <li><span class="label">LinkedIn</span><a href="https://www.linkedin.com/in/arel-urbanozo-6a0b07334/" rel="noopener">linkedin.com/in/arel-urbanozo</a></li>
          <li><span class="label">GitHub</span><a href="https://github.com/urbznspices" rel="noopener">github.com/urbznspices</a></li>
          <li><span class="label">Résumé</span><a href="/Arel_Urbanozo_Resume.pdf">Download PDF</a></li>
        </ul>
      </div>
      <div class="wrap fine">
        <span>© {new Date().getFullYear()} Arel Urbanozo · Huntsville, AL</span>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        const next = current === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--accent); color: var(--accent-ink); padding: 8px 14px; border-radius: 6px; z-index: 100; }
  .skip:focus { left: 8px; }
  .site-header {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; gap: 16px; }
  .brand { font-size: 17px; font-weight: 700; letter-spacing: -.01em; color: var(--ink); white-space: nowrap; }
  .brand:hover { color: var(--ink); text-decoration: none; }
  nav { display: flex; align-items: center; gap: clamp(12px, 2.4vw, 28px); }
  nav a { font-size: 15px; font-weight: 500; color: var(--ink-2); }
  nav a:hover { color: var(--ink); text-decoration: none; }
  nav a[aria-current='page'] { color: var(--accent); }
  .theme { background: none; border: 1px solid var(--line); color: var(--muted); width: 32px; height: 32px; border-radius: 6px; display: grid; place-items: center; cursor: pointer; }
  .theme:hover { color: var(--ink); border-color: var(--line-strong); }
  @media (max-width: 560px) {
    nav a[href='/#experience'] { display: none; }
    nav { gap: 14px; }
    nav a { font-size: 14px; }
  }

  .site-footer { border-top: 1px solid var(--line); background: var(--surface); }
  .foot { display: grid; grid-template-columns: 1fr 1.4fr; gap: 40px; padding-block: 56px 40px; }
  .foot-title { font-size: 24px; }
  .foot p { color: var(--muted); margin: 8px 0 0; max-width: 40ch; }
  .foot-links { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 18px 32px; }
  .foot-links li { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .foot-links a { overflow-wrap: anywhere; }
  .fine { padding-block: 18px 24px; border-top: 1px solid var(--line); font-size: 13px; color: var(--muted); }
  @media (max-width: 820px) { .foot { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .foot-links { grid-template-columns: 1fr; } }
</style>
