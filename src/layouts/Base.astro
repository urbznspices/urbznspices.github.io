---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const {
  title,
  description = 'Arel Urbanozo — aerospace engineering senior at UAH. Spacecraft systems and communications engineering, CubeSat hardware, and test.',
  image = '/images/og.png',
} = Astro.props;
const fullTitle = title ? `${title} · Arel Urbanozo` : 'Arel Urbanozo · Spacecraft Systems Engineering';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/resume', label: 'Résumé' },
];
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0a0f1c" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..600&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a href="/" class="brand" aria-label="Arel Urbanozo — home">
          <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true">
            <ellipse cx="16" cy="16" rx="13" ry="6.5" fill="none" stroke="currentColor" stroke-width="1.6" transform="rotate(-24 16 16)" />
            <circle cx="16" cy="16" r="4.2" fill="currentColor" />
            <circle cx="27.4" cy="10.6" r="2.2" class="sat" />
          </svg>
          <span>Arel Urbanozo</span>
        </a>
        <nav aria-label="Primary">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          <button class="theme" type="button" aria-label="Toggle color theme" title="Toggle theme">
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9c0-.5 0-.9-.1-1.4A5.5 5.5 0 0 1 13.4 3.1 9 9 0 0 0 12 3z" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap foot">
        <div>
          <p class="eyebrow"><span class="dot"></span>Open to spacecraft systems roles · 2027</p>
          <h2 class="foot-title">Let's build something<br /><em>that has to work the first time.</em></h2>
        </div>
        <div class="foot-links">
          <a class="btn primary" href="mailto:arelurbz@gmail.com">arelurbz@gmail.com</a>
          <a class="btn" href="https://www.linkedin.com/in/arel-urbanozo-6a0b07334/" rel="noopener">LinkedIn</a>
          <a class="btn" href="https://github.com/urbznspices" rel="noopener">GitHub</a>
          <a class="btn" href="/Arel_Urbanozo_Resume.pdf">Résumé PDF</a>
        </div>
      </div>
      <div class="wrap fine">
        <span>© {new Date().getFullYear()} Arel Urbanozo · Huntsville, AL</span>
        <span>Built with Astro · hosted on GitHub Pages</span>
      </div>
    </footer>

    <script is:inline>
      document.querySelector('.theme')?.addEventListener('click', () => {
        const root = document.documentElement;
        const current = root.dataset.theme || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const next = current === 'light' ? 'dark' : 'light';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: -999px; top: 8px; background: var(--accent); color: var(--accent-ink); padding: 8px 14px; border-radius: 8px; z-index: 100; }
  .skip:focus { left: 8px; }
  .site-header {
    position: sticky; top: 0; z-index: 50;
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-size: 19px; font-weight: 600; letter-spacing: -.01em; }
  .brand svg { color: var(--ink); }
  .brand .sat { fill: var(--accent); }
  nav { display: flex; align-items: center; gap: clamp(10px, 2.4vw, 28px); }
  nav a { font-family: var(--font-mono); font-size: 13px; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; color: var(--ink-2); }
  nav a[aria-current='page'] { color: var(--accent); }
  .theme { background: none; border: 1px solid var(--line); color: var(--ink-2); width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; cursor: pointer; }
  .theme:hover { color: var(--accent); border-color: var(--accent); }
  @media (max-width: 520px) { .brand span { display: none; } }

  .site-footer { border-top: 1px solid var(--line); background: var(--bg-2); margin-top: 40px; }
  .foot { display: grid; grid-template-columns: 1.3fr 1fr; gap: 40px; padding-block: 80px 48px; align-items: end; }
  .foot-title { font-size: clamp(32px, 4.4vw, 54px); margin-top: 16px; }
  .foot-title em { color: var(--accent); font-style: italic; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; }
  .fine { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding-block: 20px 28px; border-top: 1px solid var(--line); font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
  @media (max-width: 820px) { .foot { grid-template-columns: 1fr; } .foot-links { justify-content: flex-start; } }
</style>
