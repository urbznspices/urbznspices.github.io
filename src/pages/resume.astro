---
import Base from '../layouts/Base.astro';
---
<Base title="Résumé" description="Résumé and CV of Arel Urbanozo, B.S. Aerospace Engineering, UAH, May 2027.">
  <section class="wrap page">
    <div class="top">
      <div>
        <p class="label">Résumé</p>
        <h1>Résumé</h1>
        <p class="sub">One-page résumé below. The full CV adds coursework, projects and teaching detail.</p>
      </div>
      <div class="actions">
        <a class="btn primary" href="/Arel_Urbanozo_Resume.pdf" download>Download résumé (PDF)</a>
        <a class="btn" href="/Arel_Urbanozo_CV.pdf">Full CV (PDF)</a>
      </div>
    </div>
    <object class="pdf" data="/Arel_Urbanozo_Resume.pdf#view=FitH" type="application/pdf" aria-label="Résumé PDF">
      <p>Your browser can't display PDFs inline. <a href="/Arel_Urbanozo_Resume.pdf">Open the résumé</a>.</p>
    </object>
  </section>
</Base>

<style>
  .page { padding-block: clamp(32px, 6vw, 64px) 56px; }
  .top { display: flex; justify-content: space-between; align-items: end; gap: 24px; flex-wrap: wrap; margin-bottom: 24px; }
  h1 { margin-top: 10px; }
  .sub { color: var(--muted); margin: 8px 0 0; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .pdf { width: 100%; height: min(1150px, 130vw); border: 1px solid var(--line); border-radius: var(--radius); background: #fff; }
</style>
