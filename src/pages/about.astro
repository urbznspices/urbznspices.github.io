---
import Base from '../layouts/Base.astro';
import { education } from '../data/experience';
const timeline = [
  { when: '2023', what: "Started the B.S. in Aerospace Engineering at UAH. Joined the Space Hardware Club and designed my first flight board (Ho'omau CanSat)." },
  { when: '2024', what: 'Led CanSat Team Shockwave to 2nd place internationally and top U.S. team. Joined the ETLC as a student A/V specialist.' },
  { when: '2025', what: 'Teaching Assistant for EGR 101 (Introduction to Computing for Engineers), supporting Python and MATLAB instruction.' },
  { when: '2026', what: 'Joined the UAH IDEAS Lab as a Research Assistant: Lead Systems Engineer & Communications Lead on ChargerSat-2, and curriculum, hardware and test for INTREPID.' },
  { when: '2027', what: 'B.S. Aerospace Engineering expected in May. Seeking spacecraft systems engineering roles, then a graduate degree in engineering management.' },
];
const looking = [
  { k: 'Roles', v: 'Spacecraft / small-satellite systems engineering; mission and communications engineering; technical program support' },
  { k: 'Start', v: 'Full-time from June 2027' },
  { k: 'Location', v: 'Huntsville, AL, or open to relocation' },
];
---
<Base title="About" description="About Arel Urbanozo: aerospace engineering senior at UAH focused on spacecraft systems and communications engineering.">
  <section class="wrap about">
    <div class="intro">
      <p class="label">About</p>
      <h1>About me</h1>
      <div class="prose">
        <p>
          I'm an aerospace engineering senior at the University of Alabama in Huntsville, minutes from NASA's Marshall Space Flight
          Center. My work centers on spacecraft systems engineering: the requirements, interfaces, budgets and verification that make
          separately designed subsystems work as one vehicle.
        </p>
        <p>
          At the UAH IDEAS Lab I'm the Lead Systems Engineer and Communications Lead for <a href="/projects/chargersat-2">ChargerSat-2</a>,
          a 12U CubeSat run under NASA Class D practice. I coordinate eight subsystem teams through Phase A and own the radio link from
          link budget to licensing strategy. On the NASA-funded <a href="/projects/intrepid-payload-pcb">INTREPID</a> program I design the
          payload hardware, test campaigns and curriculum that high-school teams use to build their own lunar CubeSat payloads.
        </p>
        <p>
          Before that, I led CanSat Team Shockwave as a first-year student, taking ten engineers through PDR, CDR, environmental testing
          and flight to a 2nd-place international finish. That experience is why I care about clear interfaces, honest schedules and
          documentation that the next person can actually use.
        </p>
        <p>
          Long term, I want to lead small-satellite programs as a technical project manager, and I plan to pursue a master's degree in
          engineering management.
        </p>
      </div>

      <h2>What I'm looking for</h2>
      <dl class="looking">
        {looking.map((l) => <div><dt class="label">{l.k}</dt><dd>{l.v}</dd></div>)}
      </dl>

      <h2>Timeline</h2>
      <ol class="tl">
        {timeline.map((t) => (
          <li><span class="when">{t.when}</span><p>{t.what}</p></li>
        ))}
      </ol>

      <h2>Outside of engineering</h2>
      <div class="prose">
        <p>
          I'm a published classical composer and am writing original stage musicals, both book and score. I grew up in Kamuela, on the Island
          of Hawai'i, where I pitched for Hawaii Preparatory Academy's baseball team, and I now row with the UAH Rowing Club.
        </p>
      </div>
      <div class="photos">
        <figure>
          <img src="/images/about-composing.webp" alt="Arel Urbanozo writing music at a piano." width="840" height="1100" loading="lazy" />
          <figcaption>Composing at the piano.</figcaption>
        </figure>
        <figure>
          <img src="/images/about-baseball.webp" alt="Arel Urbanozo pitching for Hawaii Preparatory Academy." width="1200" height="800" loading="lazy" />
          <figcaption>Pitching for Hawaii Preparatory Academy, Kamuela, Hawai'i.</figcaption>
        </figure>
      </div>
    </div>

    <aside class="card side">
      <img src="/images/headshot.webp" alt="Portrait of Arel Urbanozo" width="604" height="900" />
      <dl>
        <div><dt class="label">Education</dt><dd>{education.degree}<br />{education.school}</dd></div>
        <div><dt class="label">Graduation</dt><dd>May 2027 · GPA {education.gpa}</dd></div>
        <div><dt class="label">Based in</dt><dd>Huntsville, AL</dd></div>
      </dl>
      <div class="side-actions">
        <a class="btn primary" href="/Arel_Urbanozo_Resume.pdf">Download résumé</a>
        <a class="btn" href="mailto:arelurbz@gmail.com">Email me</a>
      </div>
    </aside>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 64px; padding-block: clamp(32px, 6vw, 64px) 72px; }
  h1 { margin: 10px 0 24px; }
  .intro > h2 { font-size: 22px; margin: 48px 0 18px; padding-top: 28px; border-top: 1px solid var(--line); }
  .looking { margin: 0; display: grid; gap: 14px; }
  .looking div { display: grid; grid-template-columns: 120px 1fr; gap: 16px; }
  .looking dt { padding-top: 3px; }
  .looking dd { margin: 0; color: var(--ink-2); }
  .tl { list-style: none; margin: 0; padding: 0; }
  .tl li { display: grid; grid-template-columns: 120px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .tl li:first-child { padding-top: 0; }
  .when { font-weight: 700; color: var(--ink); }
  .tl p { margin: 0; color: var(--ink-2); max-width: 66ch; }
  .photos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 20px; }
  .photos figure { margin: 0; }
  .photos img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); }
  .photos figure:first-child img { object-position: 50% 30%; }
  .photos figcaption { font-size: 14px; color: var(--muted); margin-top: 6px; }
  .side { position: sticky; top: 84px; align-self: start; padding: 16px; display: flex; flex-direction: column; gap: 18px; }
  .side img { border-radius: 6px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 18%; width: 100%; }
  .side dl { margin: 0; display: grid; gap: 12px; }
  .side dd { margin: 2px 0 0; font-size: 15px; }
  .side-actions { display: grid; gap: 8px; }
  @media (max-width: 900px) {
    .about { grid-template-columns: 1fr; gap: 40px; }
    .side { position: static; max-width: 360px; }
  }
  @media (max-width: 560px) {
    .looking div, .tl li { grid-template-columns: 1fr; gap: 2px; }
    .photos { grid-template-columns: 1fr; }
  }
</style>
