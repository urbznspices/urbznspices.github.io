---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const all = (await getCollection('projects', ({ data }) => !data.draft || import.meta.env.DEV)).sort((a, b) => a.data.order - b.data.order);
  return all.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: all[i - 1] ?? null, next: all[i + 1] ?? null },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

const facts = [
  { k: 'Role', v: d.role },
  { k: 'Organization', v: d.org },
  { k: 'Timeline', v: d.dates },
  { k: 'Status', v: d.status },
  ...(d.teamSize ? [{ k: 'Team', v: d.teamSize }] : []),
];
const heroImg = d.hero ?? d.cover;
const heroAlt = d.hero ? (d.heroAlt ?? d.coverAlt) : d.coverAlt;
---
<Base title={d.title} description={d.tagline}>
  <article>
    <header class="head">
      <div class="wrap">
        <nav class="crumbs" aria-label="Breadcrumb"><a href="/#projects">Projects</a> <span aria-hidden="true">/</span> <span>{d.title}</span></nav>
        <h1>{d.title}</h1>
        <p class="tagline">{d.tagline}</p>
        <dl class="facts">
          {facts.map((f) => <div><dt class="label">{f.k}</dt><dd>{f.v}</dd></div>)}
        </dl>
      </div>
    </header>

    {d.demo ? (
      <section class="wrap demo" aria-label="Interactive demo">
        <div class="demo-bar">
          <p class="label">Interactive demo · runs in your browser</p>
          <a class="btn" href={d.demo.src} target="_blank" rel="noopener">Open full screen ↗</a>
        </div>
        <div class="frame" style={`--h:${d.demo.height}px`}>
          <iframe src={d.demo.src} title={`${d.title} interactive demo`} loading="lazy"></iframe>
        </div>
      </section>
    ) : (
      <figure class="wrap cover">
        <img src={heroImg} alt={heroAlt} />
      </figure>
    )}

    {(d.summary || d.metrics.length > 0) && (
      <section class="wrap glance" aria-label="At a glance">
        {d.summary && (
          <dl class="summary">
            <div><dt class="label">Challenge</dt><dd>{d.summary.challenge}</dd></div>
            <div><dt class="label">My contribution</dt><dd>{d.summary.contribution}</dd></div>
            <div><dt class="label">Result</dt><dd>{d.summary.result}</dd></div>
          </dl>
        )}
        {d.metrics.length > 0 && (
          <dl class="metrics">
            {d.metrics.map((m) => <div><dd>{m.value}</dd><dt>{m.label}</dt></div>)}
          </dl>
        )}
      </section>
    )}

    <div class="wrap body">
      <div class="prose"><Content /></div>
      <aside class="side">
        <div class="side-block">
          <p class="label">Tools &amp; methods</p>
          <ul class="tags">{d.tools.map((t) => <li class="tag">{t}</li>)}</ul>
        </div>
        {d.video && (
          <figure class="clip">
            <video src={d.video} autoplay muted loop playsinline preload="metadata" aria-label={`${d.title} screen recording`}></video>
            <figcaption>Screen recording</figcaption>
          </figure>
        )}
        {d.links.length > 0 && (
          <div class="side-block">
            <p class="label">Related</p>
            <ul class="links">
              {d.links.map((l) => <li><a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label}{l.href.startsWith('http') ? ' ↗' : ' →'}</a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </div>

    {d.gallery.length > 0 && (
      <section class="wrap gallery" aria-labelledby="figures">
        <h2 id="figures">Figures</h2>
        <div class="grid">
          {d.gallery.map((g, i) => (
            <figure>
              <a href={g.src} target="_blank" rel="noopener"><img src={g.src} alt={g.alt} loading="lazy" /></a>
              <figcaption><strong>Figure {i + 1}.</strong> {g.caption ?? g.alt}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <nav class="wrap pager" aria-label="More projects">
      {prev ? <a href={`/projects/${prev.id}`}><span class="label">← Previous</span><strong>{prev.data.title}</strong></a> : <span></span>}
      {next ? <a class="nx" href={`/projects/${next.id}`}><span class="label">Next →</span><strong>{next.data.title}</strong></a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .head { padding-block: clamp(32px, 5vw, 56px) 0; }
  .crumbs { font-size: 14px; color: var(--muted); margin-bottom: 20px; }
  .crumbs span[aria-hidden] { margin-inline: 6px; }
  h1 { max-width: 22ch; }
  .tagline { font-size: clamp(18px, 1.9vw, 21px); line-height: 1.5; max-width: 60ch; color: var(--ink-2); margin: 14px 0 28px; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); margin: 0; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .facts > div { padding: 14px 18px; border-left: 1px solid var(--line); }
  .facts > div:first-child { border-left: 0; }
  .facts dd { margin: 4px 0 0; font-size: 15px; font-weight: 500; }

  .cover { margin-block: 32px 0; }
  .cover img { width: 100%; max-height: 560px; object-fit: cover; border-radius: var(--radius); border: 1px solid var(--line); background: var(--surface-2); }

  .demo { margin-top: 32px; }
  .demo-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
  .demo-bar .label { margin: 0; }
  .frame { border: 1px solid var(--line-strong); border-radius: var(--radius); overflow: hidden; background: #fff; }
  .frame iframe { width: 100%; height: var(--h); border: 0; display: block; }
  @media (max-width: 700px) { .frame iframe { height: 620px; } }

  .glance { margin-top: 32px; display: grid; gap: 16px; }
  .summary { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .summary > div { padding: 18px 20px; border-left: 1px solid var(--line); }
  .summary > div:first-child { border-left: 0; }
  .summary dd { margin: 6px 0 0; font-size: 15px; color: var(--ink-2); line-height: 1.55; }
  .metrics { margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
  .metrics > div { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .metrics dd { margin: 0; font-size: 26px; font-weight: 700; letter-spacing: -.02em; line-height: 1.1; color: var(--accent); }
  .metrics dt { font-size: 14px; color: var(--muted); line-height: 1.4; }

  .body { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 56px; padding-block: 48px 40px; }
  .side { display: flex; flex-direction: column; gap: 24px; position: sticky; top: 84px; align-self: start; }
  .side-block .label { margin: 0 0 10px; }
  .tags, .links { list-style: none; margin: 0; padding: 0; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .links { display: grid; gap: 8px; font-size: 15px; }
  .clip { margin: 0; }
  .clip video { width: 100%; border-radius: var(--radius); border: 1px solid var(--line); }
  .clip figcaption { font-size: 13px; color: var(--muted); margin-top: 6px; }

  .gallery { padding-block: 8px 40px; border-top: 1px solid var(--line); }
  .gallery h2 { font-size: 24px; margin: 32px 0 20px; }
  .gallery .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: contain; border-radius: var(--radius); border: 1px solid var(--line); background: #fff; }
  .gallery figcaption { font-size: 14.5px; color: var(--muted); margin-top: 8px; line-height: 1.5; }
  .gallery figcaption strong { color: var(--ink); font-weight: 600; }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding-block: 32px 48px; border-top: 1px solid var(--line); }
  .pager a { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); color: var(--ink); }
  .pager a:hover { border-color: var(--line-strong); text-decoration: none; }
  .pager a:hover strong { color: var(--accent); }
  .pager strong { font-weight: 600; font-size: 17px; }
  .pager .nx { text-align: right; }

  @media (max-width: 900px) {
    .body { grid-template-columns: 1fr; gap: 32px; }
    .side { position: static; order: -1; }
    .summary { grid-template-columns: 1fr; }
    .summary > div { border-left: 0; border-top: 1px solid var(--line); }
    .summary > div:first-child { border-top: 0; }
  }
  @media (max-width: 620px) {
    .facts { grid-template-columns: 1fr 1fr; }
    .facts > div { border-left: 0; border-top: 1px solid var(--line); }
    .facts > div:nth-child(-n+2) { border-top: 0; }
    .facts > div:nth-child(even) { border-left: 1px solid var(--line); }
    .pager, .gallery .grid { grid-template-columns: 1fr; }
  }
</style>
