---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceItem from '../components/ExperienceItem.astro';
import { experience, skills, education } from '../data/experience';

const projects = (await getCollection('projects', ({ data }) => !data.draft || import.meta.env.DEV)).sort((a, b) => a.data.order - b.data.order);

const facts = [
  { k: 'Degree', v: 'B.S. Aerospace Engineering, UAH' },
  { k: 'Graduation', v: 'May 2027' },
  { k: 'GPA', v: education.gpa },
  { k: 'Location', v: 'Huntsville, AL' },
];
---
<Base>
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="copy">
        <p class="label">Aerospace Engineering · Spacecraft Systems</p>
        <h1>Arel Urbanozo</h1>
        <p class="lede">
          Aerospace engineering senior at the University of Alabama in Huntsville. I lead systems and communications engineering on
          ChargerSat-2, a 12U NASA Class D CubeSat, and design flight and classroom hardware for NASA-funded student space programs.
        </p>
        <p class="sub">
          I'm seeking spacecraft systems engineering roles starting in 2027, with a long-term path toward technical program management.
        </p>
        <div class="ctas">
          <a class="btn primary" href="/Arel_Urbanozo_Resume.pdf">Download résumé</a>
          <a class="btn" href="https://www.linkedin.com/in/arel-urbanozo-6a0b07334/" rel="noopener">LinkedIn</a>
          <a class="btn" href="mailto:arelurbz@gmail.com">Email</a>
        </div>
      </div>
      <figure class="portrait">
        <img src="/images/headshot.webp" alt="Portrait of Arel Urbanozo" width="604" height="900" fetchpriority="high" />
      </figure>
    </div>
    <div class="wrap">
      <dl class="facts">
        {facts.map((f) => (
          <div><dt class="label">{f.k}</dt><dd>{f.v}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <section id="experience" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Experience</p>
        <div>
          <h2>Experience &amp; leadership</h2>
          <p>Research, leadership and teaching roles, most recent first.</p>
        </div>
      </div>
      <div class="xp">
        {experience.map((r) => <ExperienceItem role={r} />)}
      </div>
    </div>
  </section>

  <section id="projects" class="section alt">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Projects</p>
        <div>
          <h2>Selected projects</h2>
          <p>Each case study covers the problem, my role, the technical approach, results, and lessons learned.</p>
        </div>
      </div>
      <div class="grid">
        {projects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section id="skills" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Skills</p>
        <div><h2>Technical skills</h2></div>
      </div>
      <div class="skills">
        {skills.map((s) => (
          <div class="skill card">
            <h3>{s.area}</h3>
            <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="education" class="section alt">
    <div class="wrap">
      <div class="section-head">
        <p class="label">Education</p>
        <div><h2>Education &amp; honors</h2></div>
      </div>
      <div class="edu">
        <div class="card edu-main">
          <div class="edu-top">
            <div>
              <h3>{education.school}</h3>
              <p class="deg">{education.degree} · GPA {education.gpa}</p>
            </div>
            <p class="when">{education.dates}</p>
          </div>
          <h4>Relevant coursework</h4>
          <ul class="chips">{education.coursework.map((c) => <li class="tag">{c}</li>)}</ul>
        </div>
        <div class="card edu-side">
          <h4>Awards</h4>
          <ul class="plain">
            {education.awards.map((a) => <li><strong>{a.title}</strong><span>{a.detail}</span></li>)}
          </ul>
          <h4>Academic honors</h4>
          <ul class="plain">{education.honors.map((h) => <li>{h}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(48px, 7vw, 88px) clamp(40px, 5vw, 56px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: clamp(32px, 6vw, 80px); align-items: center; }
  h1 { margin: 12px 0 20px; }
  .lede { font-size: clamp(18px, 1.8vw, 20px); line-height: 1.6; color: var(--ink); max-width: 60ch; margin: 0 0 14px; }
  .sub { color: var(--muted); max-width: 60ch; margin: 0 0 28px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 10px; }
  .portrait { margin: 0; }
  .portrait img { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 18%; border-radius: var(--radius); border: 1px solid var(--line); }

  .facts { margin: clamp(40px, 5vw, 56px) 0 0; display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
  .facts > div { padding: 16px 20px; border-left: 1px solid var(--line); }
  .facts > div:first-child { border-left: 0; }
  .facts dd { margin: 4px 0 0; font-weight: 600; font-size: 15.5px; }

  .xp { display: grid; gap: 0; }

  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }

  .skills { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .skill { padding: 20px; }
  .skill h3 { font-size: 16px; padding-bottom: 10px; margin-bottom: 12px; border-bottom: 1px solid var(--line); }
  .skill ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 7px; font-size: 14.5px; color: var(--ink-2); }

  .edu { display: grid; grid-template-columns: 1.6fr 1fr; gap: 16px; }
  .edu-main, .edu-side { padding: 24px; }
  .edu-top { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 22px; }
  .deg { margin: 4px 0 0; color: var(--ink-2); }
  .when { margin: 0; color: var(--muted); font-size: 14.5px; }
  h4 { margin: 0 0 10px; }
  .chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .plain { list-style: none; margin: 0 0 22px; padding: 0; display: grid; gap: 8px; font-size: 15px; color: var(--ink-2); }
  .plain:last-child { margin-bottom: 0; }
  .plain li { display: flex; flex-direction: column; }
  .plain span { color: var(--muted); font-size: 14px; }

  @media (max-width: 960px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .portrait { order: -1; max-width: 200px; }
    .facts { grid-template-columns: 1fr 1fr; }
    .facts > div:nth-child(3) { border-left: 0; }
    .facts > div:nth-child(n+3) { border-top: 1px solid var(--line); }
    .edu { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .grid, .skills { grid-template-columns: 1fr; }
  }
</style>
